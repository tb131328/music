diff --git a/src/utils/cdnProxy.js b/src/utils/cdnProxy.js
new file mode 100644
index 0000000..4f2d0ac
--- /dev/null
+++ b/src/utils/cdnProxy.js
@@ -0,0 +1,27 @@
+function getProxyOrigin() {
+    if (process.env.IS_ELECTRON === true) return 'http://localhost:3001';
+    if (typeof window === 'undefined') return null;
+
+    const { protocol, hostname } = window.location;
+    const forwardedHostname = hostname.replace(
+        /-\d+(?=\.app\.github\.dev$)/,
+        '-3001'
+    );
+
+    if (forwardedHostname !== hostname) {
+        return `${protocol}//${forwardedHostname}`;
+    }
+
+    return `${protocol}//${hostname}:3001`;
+}
+
+export default function cdnProxy(url) {
+    if (!url || typeof url !== 'string' || /^(data|blob):/i.test(url)) {
+        return url;
+    }
+
+    const proxyOrigin = getProxyOrigin();
+    if (!proxyOrigin || url.startsWith(`${proxyOrigin}/`)) return url;
+
+    return `${proxyOrigin}/${encodeURIComponent(url)}`;
+}
